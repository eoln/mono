# EOLN Mono — Automation Environment Variables
# Copy to .env in repo root and fill in your values.
# .env is in .gitignore and will NOT be committed.

# --- Required ---
TELEGRAM_BOT_TOKEN=          # From @BotFather on Telegram
ANTHROPIC_API_KEY=           # From console.anthropic.com
GITHUB_TOKEN=                # GitHub PAT with repo scope

# --- Telegram ---
TELEGRAM_CHAT_ID=            # Your Telegram user/chat ID (get from @userinfobot)

# --- ZenHub (optional) ---
ZENHUB_API_TOKEN=            # From app.zenhub.com → Settings → API
ZENHUB_WORKSPACE_ID=         # Your ZenHub workspace ID
GITHUB_REPO_ID=              # Numeric GitHub repo ID (for ZenHub API)

# --- Notion (optional) ---
NOTION_TOKEN=                # From notion.so/my-integrations
NOTION_SPRINT_DB_ID=         # Database ID for sprint board sync

# --- n8n (optional) ---
N8N_WEBHOOK_URL=             # Base URL for n8n webhook triggers
N8N_API_KEY=                 # n8n API key for programmatic workflow management
