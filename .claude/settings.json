{
  "permissions": {
    "allow": [
      "Bash(rush *)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(git *)",
      "Bash(coffee *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo *)"
    ]
  },
  "preferences": {
    "autoCommit": false,
    "testBeforeCommit": true
  }
}
